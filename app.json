{
  "expo": {
    "name": "Poker Chips",
    "slug": "poker-chips",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pokerchips",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokerchips.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.pokerchips.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
